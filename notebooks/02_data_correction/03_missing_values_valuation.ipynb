    "    \n",
    "    print(f\"\\nDESPUÉS DEL FILTRADO:\")\n",
    "    print(f\"  - Número de observaciones: {len(filtered_distances)}\")\n",
    "    print(f\"  - Media: {np.mean(filtered_distances):.3f}\")\n",
