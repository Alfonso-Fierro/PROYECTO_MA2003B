    "import re\n",
    "\n",
    "def limpiar_estacion(valor):\n",
    "    if pd.isna(valor):\n",
    "        return valor\n",
    "    # 1. A mayúsculas\n",
    "    val = str(valor).upper().strip()\n",
    "    # 2. Quitar espacios redundantes\n",
    "    val = re.sub(r'\\s+', ' ', val)\n",
    "    # 3. Unificar \"X 2\" y \"X2\"\n",
    "    val = re.sub(r'(\\D)\\s+(\\d+)', r'\\1\\2', val)  \n",
    "    return val\n",
    "\n",
    "df['estacion_limpia'] = df['estacion'].apply(limpiar_estacion)\n",
    "\n",
    "print(sorted(df['estacion_limpia'].unique()))\n"
   ]
