   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import re\n",
    "\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.discriminant_analysis import LinearDiscriminantAnalysis\n",
    "from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay\n",
    "\n",
    "# ==========================\n",
    "# Funciones auxiliares\n",
    "# ==========================\n",
    "def limpiar_estacion(valor):\n",
    "    \"\"\"Limpia nombres de estación: mayúsculas, quitar espacios extras, unificar X 2 → X2\"\"\"\n",
    "    if pd.isna(valor):\n",
    "        return valor\n",
    "    val = str(valor).upper().strip()\n",
    "    val = re.sub(r'\\s+', ' ', val)\n",
    "    val = re.sub(r'(\\D)\\s+(\\d+)', r'\\1\\2', val)\n",
    "    return val\n",
    "\n",
    "def agrupar_estacion(valor):\n",
    "    \"\"\"Agrupa estaciones por macrozona\"\"\"\n",
    "    if pd.isna(valor):\n",
    "        return valor\n",
    "    if \"SURESTE\" in valor:\n",
    "        return \"SURESTE\"\n",
    "    elif \"SUROESTE\" in valor:\n",
    "        return \"SUROESTE\"\n",
    "    elif \"NORESTE\" in valor:\n",
    "        return \"NORESTE\"\n",
    "    elif \"NOROESTE\" in valor:\n",
    "        return \"NOROESTE\"\n",
    "    elif \"NORTE\" in valor:\n",
    "        return \"NORTE\"\n",
    "    elif \"SUR\" in valor:\n",
    "        return \"SUR\"\n",
    "    elif \"ESTE\" in valor:\n",
    "        return \"ESTE\"\n",
    "    elif \"OESTE\" in valor:\n",
    "        return \"OESTE\"\n",
    "    else:\n",
    "        return valor\n",
    "\n",
    "# ==========================\n",
    "# Cargar datos\n",
    "# ==========================\n",
    "df = pd.read_csv(\"/Users/oscarcasas/multi/PROYECTO_MA2003B/data/processed/master_table.csv\")\n",
    "\n",
    "# Limpiar y agrupar estaciones\n",
    "df['estacion'] = df['estacion'].apply(limpiar_estacion)\n",
    "df['estacion_grupo'] = df['estacion'].apply(agrupar_estacion)\n",
    "\n",
    "print(\"Estaciones únicas (limpias):\", sorted(df['estacion'].dropna().unique()))\n",
    "print(\"Grupos de estaciones:\", sorted(df['estacion_grupo'].dropna().unique()))\n",
    "\n",
    "# ==========================\n",
    "# Preparar X y y\n",
    "# ==========================\n",
    "cols_excluir = [\"estacion\", \"archivo_origen\", \"date_index\"]\n",
    "X = df.drop(columns=cols_excluir)\n",
    "y = df[\"estacion_grupo\"]\n",
    "\n",
    "# Seleccionar solo columnas numéricas\n",
    "X_numeric = X.select_dtypes(include=\"number\")\n",
    "\n",
    "# Imputar y escalar\n",
    "imputer = SimpleImputer(strategy=\"mean\")\n",
    "X_imputed = imputer.fit_transform(X_numeric)\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X_imputed)\n",
    "\n",
    "# ==========================\n",
    "# 1. PCA\n",
    "# ==========================\n",
    "pca = PCA(n_components=2)\n",
    "X_pca = pca.fit_transform(X_scaled)\n",
    "\n",
    "print(\"Varianza explicada por cada componente:\", pca.explained_variance_ratio_)\n",
    "print(\"Varianza total explicada:\", pca.explained_variance_ratio_.sum())\n",
    "\n",
    "pca_df = pd.DataFrame(X_pca, columns=[\"PC1\", \"PC2\"])\n",
    "pca_df[\"grupo\"] = y\n",
    "\n",
    "plt.figure(figsize=(8,6))\n",
    "sns.scatterplot(data=pca_df, x=\"PC1\", y=\"PC2\", hue=\"grupo\", palette=\"Set2\")\n",
    "plt.title(\"PCA - Biplot (2 componentes principales)\")\n",
    "plt.legend(fontsize=8, title=\"Grupo\")\n",
    "plt.xticks(fontsize=8)\n",
    "plt.yticks(fontsize=8)\n",
    "plt.show()\n",
    "\n",
    "# ==========================\n",
    "# 2. LDA general\n",
    "# ==========================\n",
    "lda = LinearDiscriminantAnalysis()\n",
    "X_lda = lda.fit_transform(X_scaled, y)\n",
    "\n",
    "# Predicciones y matriz de confusión\n",
    "y_pred = lda.predict(X_scaled)\n",
    "cm = confusion_matrix(y, y_pred, labels=lda.classes_)\n",
    "disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=lda.classes_)\n",
    "disp.plot(cmap=\"Blues\", xticks_rotation=45)\n",
    "plt.title(\"Matriz de confusión - LDA\")\n",
    "plt.show()\n",
    "\n",
    "# Gráfico LDA general\n",
    "if X_lda.shape[1] >= 2:\n",
    "    lda_df = pd.DataFrame(X_lda[:, :2], columns=[\"LD1\", \"LD2\"])\n",
    "    lda_df[\"grupo\"] = y\n",
    "    \n",
    "    plt.figure(figsize=(8,6))\n",
    "    sns.scatterplot(data=lda_df, x=\"LD1\", y=\"LD2\", hue=\"grupo\", palette=\"Set2\")\n",
    "    plt.title(\"LDA - Todos los grupos\")\n",
    "    plt.legend(fontsize=8, title=\"Grupo\")\n",
    "    plt.xticks(fontsize=8)\n",
    "    plt.yticks(fontsize=8)\n",
    "    plt.show()\n",
    "else:\n",
    "    print(\"El LDA solo generó una dimensión discriminante (LD1).\")\n",
    "\n",
    "# ==========================\n",
    "# 3. LDA por cada macrogrupo\n",
    "# ==========================\n",
    "for grupo in sorted(y.unique()):\n",
    "    subset = lda_df[lda_df['grupo'] == grupo]\n",
    "    plt.figure(figsize=(6,5))\n",
